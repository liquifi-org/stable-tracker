PORT=3003
SERVER_URL=http://localhost
ENV=development
LOG_LEVEL=info

# Database configuration
# Local:  mongodb://localhost:27017/sc-tracker
# Docker: mongodb://mongo:27017/sc-tracker  (uses the Compose service name)
DB_URL=mongodb://localhost:27017/sc-tracker

# CORS (comma-separated list of allowed origins)
# Production: https://stabletracker.org,https://www.stabletracker.org
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Private admin sync endpoints. Leave empty to disable (fails closed).
ADMIN_SYNC_TOKEN=

# Migration settings

MIGRATE_MONGO_URI=mongodb://localhost:27017/sc-tracker
MIGRATE_MONGO_COLLECTION=migrations
MIGRATE_MIGRATIONS_PATH=./migrations
MIGRATE_AUTOSYNC=false

STRIDE_API_KEY=

# Telegram (contact form notifications)
# Create a bot with @BotFather, then send /start to it (or add it to a group).
# TELEGRAM_CHAT_ID can be a user id, group id, or comma-separated list.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Allium Explorer API (wallet counts per country)
# Get it from: Allium > Queries > select any > Run via API > copy API Key
ALLIUM_API_KEY=
# Optional: override the default wallet-counts query id
# ALLIUM_WALLETS_QUERY_ID=VsBubvbe7ZyzFNB3xx9Q
# Optional: override the default corridors query id
# Adjusted volume (default): 8YuhvYmP5xLFOqLuuHCZ
# Raw archive:               djvIso1YNXUFa34rTjdD
# ALLIUM_CORRIDORS_QUERY_ID=8YuhvYmP5xLFOqLuuHCZ
